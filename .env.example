# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string. Leave unset for local development to use the
# embedded PostgreSQL (PGlite) stored in .data/pglite. On Netlify, Netlify Database
# is provisioned automatically and exposes NETLIFY_DB_URL (used if DATABASE_URL is unset).
# DATABASE_URL=postgres://cubesat:change-me@localhost:5432/cubesat
# DATABASE_SSL=true
# DATABASE_POOL_SIZE=10

# ─── Private file storage (outside /public) ─────────────────
# On Netlify, uploads go to Netlify Blobs automatically. FILE_STORAGE=netlify forces it.
UPLOAD_DIR=storage/uploads
MAX_IMAGE_MB=5
MAX_CV_MB=5
MAX_IMAGES=8

# ─── Institutional rules (set these to MTC's official formats) ──
# Regex the student ID must match. Unset = 3–20 letters/digits/hyphens.
# STUDENT_ID_PATTERN=
# STUDENT_ID_HINT_EN=
# STUDENT_ID_HINT_AR=

# ─── Security ───────────────────────────────────────────────
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
ADMIN_SESSION_HOURS=8
# COOKIE_SECURE defaults to true in production.

# ─── Retention ──────────────────────────────────────────────
DRAFT_RETENTION_DAYS=30
# Delete submitted applications older than N days when `npm run retention:purge` runs.
# APPLICATION_RETENTION_DAYS=365

# ─── Admin accounts (sign-in is by email only) ──────────────
# Comma-separated admin emails; each becomes an admin on first sign-in.
# Use this on Netlify (Site configuration → Environment variables).
# ADMIN_EMAILS=lead@example.org,second@example.org
# Or create accounts with `npm run admin:create` using:
# ADMIN_EMAIL=
# ADMIN_NAME=
